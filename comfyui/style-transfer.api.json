{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Diffusion model"},
    "inputs": {
      "unet_name": "qwen_image_2.1_turbo_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "Text encoder"},
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {"title": "VAE"},
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    }
  },
  "4": {
    "class_type": "LoadImage",
    "_meta": {"title": "Source image"},
    "inputs": {
      "image": "source.png"
    }
  },
  "5": {
    "class_type": "TextEncodeQwenImage21",
    "_meta": {"title": "Style prompt"},
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": "Redraw <image1> in the target style.",
      "negative_prompt": "",
      "resolution": 1024,
      "images.image_1": ["4", 0]
    }
  },
  "6": {
    "class_type": "QwenImage21Cache",
    "_meta": {"title": "KV cache"},
    "inputs": {
      "model": ["1", 0],
      "device": "auto",
      "dtype": "default"
    }
  },
  "7": {
    "class_type": "CFGGuider",
    "_meta": {"title": "Guider"},
    "inputs": {
      "model": ["6", 0],
      "positive": ["5", 0],
      "negative": ["5", 1],
      "cfg": 1.0
    }
  },
  "8": {
    "class_type": "KSamplerSelect",
    "_meta": {"title": "Sampler"},
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "9": {
    "class_type": "ManualSigmas",
    "_meta": {"title": "Turbo sigmas (8 steps)"},
    "inputs": {
      "sigmas": "1.0, 0.978453, 0.95418, 0.926626, 0.89508, 0.845148, 0.704534, 0.414568, 0"
    }
  },
  "10": {
    "class_type": "RandomNoise",
    "_meta": {"title": "Seed"},
    "inputs": {
      "noise_seed": 0
    }
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "_meta": {"title": "Sample"},
    "inputs": {
      "noise": ["10", 0],
      "guider": ["7", 0],
      "sampler": ["8", 0],
      "sigmas": ["9", 0],
      "latent_image": ["5", 2]
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "_meta": {"title": "Decode"},
    "inputs": {
      "samples": ["11", 0],
      "vae": ["3", 0]
    }
  },
  "13": {
    "class_type": "SaveImage",
    "_meta": {"title": "Save"},
    "inputs": {
      "images": ["12", 0],
      "filename_prefix": "style-transfer"
    }
  }
}
